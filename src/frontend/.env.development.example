# 开发环境变量示例（复制为 .env.development 使用）
# 后端 API 基础地址（开发环境直连本地后端）
VITE_API_BASE_URL=http://localhost:5156
# 是否使用前端 Mock（true=Mock / false=真实接口）
VITE_USE_MOCK=true
# 可按模块覆盖 Mock 开关（未设置时跟随 VITE_USE_MOCK）
# 示例：全局接真实接口，但申请模块后端未修复仍走 Mock
# VITE_USE_MOCK=false
# VITE_USE_MOCK_TRAINING_REQUEST=true
# VITE_USE_MOCK_COURSE=false
